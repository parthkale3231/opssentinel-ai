# OpsSentinel Backend — Environment Variables
# Copy this file to .env and fill in values. Never commit .env to Git.

# Database
DATABASE_URL=postgresql://opssentinel:changeme@localhost:5432/opssentinel

# Kubernetes
KUBERNETES_IN_CLUSTER=false
KUBECONFIG=~/.kube/config

# Prometheus
PROMETHEUS_URL=http://localhost:9090

# Loki
LOKI_URL=http://localhost:3100

# AI / LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=2000

# App settings
LOG_LEVEL=INFO
ENVIRONMENT=local
APP_NAME=opssentinel
APP_VERSION=1.0.0
SECRET_KEY=change-this-to-a-random-secret-in-production

# Remediation policy config
MAX_REMEDIATION_RETRIES=3
MAX_SCALE_REPLICAS=5
ALLOWED_NAMESPACES=demo-app
APPROVAL_REQUIRED_SEVERITY=critical

