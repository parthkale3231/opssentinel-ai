# DemoStore Backend — Environment Variables
# Copy this file to .env and fill in values. Never commit .env to Git.

DATABASE_URL=postgresql://demostore:changeme@localhost:5432/demostore
LOG_LEVEL=INFO
ENVIRONMENT=local
APP_NAME=demostore
APP_VERSION=1.0.0

# Correlation ID header name
CORRELATION_ID_HEADER=X-Correlation-ID

